{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "endeavouros_small",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" }
  },
  "modules": [
    { "type": "title", "format": "{user-name}" },
    "break",
    { "type": "os", "key": "os " },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "ram" },
    { "type": "shell", "key": "sh " }
  ]
}
