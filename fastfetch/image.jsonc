{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-icat",
    "source": "/home/fractu/Pictures/icon.jpg",
    "width": 16,
    "height": 8,
    "padding": { "top": 0, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" }
  },
  "modules": [
    { "type": "title", "format": "{user-name}" },
    "break",
    { "type": "os", "key": "os " },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "ram" },
    { "type": "shell", "key": "sh " },
    { "type": "terminal", "key": "term" },
    "break",
    "break"
  ]
}
